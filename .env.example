# Root domain the platform serves. Tenant workspaces are <slug>.<root>.
# Local dev uses localhost: visit http://localhost:3000 (apex) and
# http://demo.localhost:3000 (a tenant).
NEXT_PUBLIC_ROOT_DOMAIN=upfitopps.com

# Postgres connection string (Neon / Vercel Postgres). Required for the data
# layer, migrations, and seeding. Use Neon's POOLED connection string.
DATABASE_URL=

# Google Maps JavaScript API key (client-side), for the rep ZIP map. Restrict
# it to the Maps JavaScript API and your domains. Optional — the map degrades
# to a placeholder without it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Daily email (Resend). See EMAIL_SETUP.md. ---

# Resend API key. Without it, the daily-email job logs recipients instead of
# sending, so everything is testable locally.
RESEND_API_KEY=
# Verified sender address (the display name is per-distributor at send time:
# "{Distributor} via Upfit Opps <this-address>"). e.g. no-reply@mg.upfitopps.com
EMAIL_FROM_ADDRESS=
# Shared secret the daily-email cron must present. Vercel sends this to the
# cron route automatically when set; required in production.
CRON_SECRET=

# Note: email links are built per-distributor from NEXT_PUBLIC_ROOT_DOMAIN
# (<slug>.<root>), so there is no separate base-URL variable to set.

# --- Not yet wired; placeholders for later phases ---

# Long random secret used to sign session cookies.
# SESSION_SECRET=
